export enum LoopMode {
    Off,
    File,
    Playlist,
}

export enum AbLoopState {
    Off,
    SetA,
    Active,
}

export enum ActivePopover {
    None,
    OpenMenu,
    OpenUrlModal,
    Subtitles,
    Audio,
    Chapters,
    Settings,
    AppMenu,
}

export struct TrackItem {
    id: int,
    title: string,
    lang: string,
    codec: string,
    selected: bool,
}

export struct ChapterItem {
    index: int,
    title: string,
    time-text: string,
    norm-pos: float,
    current: bool,
}

export enum MiniState {
    Hidden,
    Tile,
    Pill,
}

export enum AppViewMode {
    Picker,
    Player,
}

export enum PickerNavKind {
    Home,
    ContinueWatching,
    Recent,
    Folder,
}

export enum PickerSortMode {
    Name,
    Recent,
    Progress,
}

export struct VideoEntry {
    id: string,
    path: string,
    title: string,
    subtitle: string,
    duration-text: string,
    duration-sec: float,
    position-sec: float,
    progress: float,
    watched: bool,
    thumbnail: image,
    has-thumbnail: bool,
}

export struct FolderNode {
    path: string,
    name: string,
    depth: int,
    has-children: bool,
    expanded: bool,
    selected: bool,
}

export struct ShelfSection {
    folder-path: string,
    title: string,
    total-count: int,
    items: [VideoEntry],
}

export struct VideoGridRow {
    row-index: int,
    items: [VideoEntry],
}

export global Theme {
    // --- Color & Gradient Tokens ---
    out property <color> canvas-bg: #000000;
    out property <color> window-border: #ffffff1a;
    out property <brush> hud-gradient-top: @linear-gradient(180deg, #000000bf 0%, #00000059 55%, #00000000 100%);
    out property <brush> hud-gradient-bottom: @linear-gradient(0deg, #000000d9 0%, #00000073 55%, #00000000 100%);

    out property <color> popover-bg: #12141ae6;
    out property <color> popover-border: #ffffff1f;
    out property <color> popover-item-hover: #ffffff14;
    out property <color> popover-item-active: #818cf826;

    out property <color> btn-circle-idle: #ffffff00;
    out property <color> btn-circle-hover: #ffffff26;
    out property <color> btn-circle-pressed: #ffffff40;
    out property <color> btn-circle-active: #ffffff33;

    out property <color> icon-primary: #ffffff;
    out property <color> icon-muted: #ffffff99;
    out property <color> icon-disabled: #ffffff40;
    out property <color> icon-accent: #818cf8;

    out property <color> text-primary: #f8fafc;
    out property <color> text-secondary: #e2e8f0;
    out property <color> text-muted: #94a3b8;

    out property <color> seek-track: #ffffff38;
    out property <color> seek-fill: #ffffff;
    out property <color> seek-ab-fill: #818cf84d;

    // --- Geometry Tokens ---
    out property <length> window-radius: 12px;
    out property <length> top-gradient-height: 64px;
    out property <length> top-bar-content-height: 56px;
    out property <length> bottom-gradient-height: 104px;
    out property <length> bottom-bar-content-height: 96px;
    out property <length> icon-btn-size: 34px;
    out property <length> icon-btn-radius: 17px;
    out property <length> icon-glyph-size: 18px;
    out property <length> popover-radius: 10px;

    // --- Video Picker Tokens ---
    out property <color> picker-bg: #090a0f;
    out property <color> sidebar-bg: #12141ae6;
    out property <color> sidebar-border: #ffffff1f;
    out property <length> sidebar-radius: 12px;
    out property <length> sidebar-width: 240px;

    out property <color> card-bg: #0f1117;
    out property <color> card-border: #ffffff14;
    out property <color> card-border-hover: #ffffff40;
    out property <length> card-radius: 10px;
    out property <color> progress-track: #ffffff38;
    out property <color> progress-fill: #818cf8;
    out property <color> pill-bg: #000000b3;

    // --- Mini Player Tokens (docs/mini-player-ui-spec.md §6.1) ---
    // The durations are read by C++ (settle timers), so the two sides cannot drift.
    out property <duration> mini-shrink-duration: 300ms;
    out property <duration> mini-expand-duration: 260ms;
    out property <duration> mini-collapse-duration: 220ms;
    out property <duration> mini-close-fade-duration: 160ms;
    // Clicks on the video are ignored this long after leaving mini mode, so the second click
    // of a double-click on the tile neither toggles pause nor fullscreen (§3.3).
    out property <duration> mini-expand-click-guard: 500ms;
    out property <length> mini-margin: 16px;
    out property <length> mini-min-width: 280px;
    out property <length> mini-max-width: 480px;
    out property <float> mini-width-ratio: 0.26;
    out property <length> mini-portrait-min-height: 220px;
    out property <length> mini-portrait-max-height: 420px;
    out property <float> mini-portrait-height-ratio: 0.40;
    out property <color> mini-scrim: #00000066;
    out property <length> mini-pill-height: 40px;
    out property <length> mini-pill-min-width: 200px;
    out property <length> mini-pill-max-width: 320px;
    out property <length> mini-pill-radius: 20px;
}
