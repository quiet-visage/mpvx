import {
    Theme,
    LoopMode,
    AbLoopState,
    ActivePopover,
    TrackItem,
    ChapterItem,
    AppViewMode,
    MiniState,
    MiniCorner,
    PickerNavKind,
    PickerSortMode,
    VideoEntry,
    FolderNode,
    ShelfSection,
    VideoGridRow,
} from "theme.slint";
import { VideoView } from "components/video-view.slint";
import { TopBar } from "components/top-bar.slint";
import { ControlsBar } from "components/controls.slint";
import { PopoverLayer } from "components/popovers.slint";
import { VideoPicker } from "components/picker/video-picker.slint";
import { MiniPill } from "components/mini-pill.slint";
import { MiniCornerGuides } from "components/mini-corner-guides.slint";

export {
    Theme,
    MiniState,
    MiniCorner,
    LoopMode,
    AbLoopState,
    ActivePopover,
    TrackItem,
    ChapterItem,
    AppViewMode,
    PickerNavKind,
    PickerSortMode,
    VideoEntry,
    FolderNode,
    ShelfSection,
    VideoGridRow,
}

export component MainWindow inherits Window {
    no-frame: true;
    title: root.media-title != "" ? root.media-title + " - mpvx" : "mpvx";
    min-width: 640px;
    min-height: 360px;
    preferred-width: 1280px;
    preferred-height: 720px;
    default-font-family: "sans-serif";
    background: transparent;
    forward-focus: key-scope;

    // --- Core Playback State ---
    in property <image> video-frame;
    in property <bool> has-video: false;
    in property <bool> is-playing: false;
    in property <bool> is-buffering: false;
    in property <float> progress: 0.0;           // 0.0 .. 1.0
    in property <string> time-text: "0:00 | 0:00";
    in property <string> media-title: "";

    // --- Audio & Volume ---
    in property <float> volume: 100.0;           // 0.0 .. 100.0 (or 150.0 boost)
    in property <bool> is-muted: false;

    // --- Loop & A/B Loop ---
    in-out property <LoopMode> loop-mode: LoopMode.Off;
    in-out property <AbLoopState> ab-loop-state: AbLoopState.Off;
    in property <float> ab-loop-a-norm: -1.0;    // Normalized 0..1 (-1 if unset)
    in property <float> ab-loop-b-norm: -1.0;    // Normalized 0..1 (-1 if unset)

    // --- Tracks, Chapters & Settings Models ---
    in property <[TrackItem]> subtitle-tracks: [];
    in property <[TrackItem]> audio-tracks: [];
    in property <[ChapterItem]> chapters: [];
    in-out property <bool> has-subtitles-enabled: false;
    in-out property <int> active-subtitle-index: -1;
    in-out property <float> playback-speed: 1.0;
    in-out property <string> hwdec-mode: "auto-safe";
    in-out property <string> aspect-ratio: "auto";

    // --- View Mode & Video Picker State ---
    in-out property <AppViewMode> view-mode: AppViewMode.Picker;
    in-out property <bool> sidebar-open: true;
    in-out property <PickerNavKind> active-nav-kind: PickerNavKind.Home;
    in-out property <PickerSortMode> picker-sort-mode: PickerSortMode.Name;
    in-out property <string> current-folder-path: "";
    in property <[FolderNode]> picker-folders: [];
    in property <[string]> picker-breadcrumbs: [];
    in property <[VideoEntry]> picker-continue-watching: [];
    in property <[VideoEntry]> picker-direct-videos: [];
    in property <[VideoGridRow]> picker-direct-video-rows: [];
    in property <int> picker-grid-columns: 4;
    in property <[ShelfSection]> picker-shelves: [];
    in-out property <string> picker-search-query: "";
    in property <bool> picker-scanning: false;

    property <float> picker-opacity: root.view-mode == AppViewMode.Picker ? 1.0 : 0.0;
    animate picker-opacity { duration: 220ms; easing: ease-out; }

    // --- Mini Player State (docs/mini-player-ui-spec.md §5, §6.2, §12) ---
    // view-mode and mini-state are always assigned together by C++; Player + Tile/Pill is invalid.
    in-out property <MiniState> mini-state: MiniState.Hidden;
    out property <bool> mini-active: root.mini-state != MiniState.Hidden;
    in-out property <MiniCorner> mini-corner: MiniCorner.BottomRight;
    out property <bool> mini-dragging: false;
    out property <bool> mini-snapping: false;
    property <length> mini-drag-x: 0px;
    property <length> mini-drag-y: 0px;
    // The tile is pinned at (mini-drag-x, mini-drag-y) without dragging: pressed mid-snap
    // (§12.3.5), or expanded mid-drag / mid-snap so the morph starts where the tile is (§12.4C).
    property <bool> mini-held: false;
    property <MiniCorner> mini-snap-preview: root.mini-dragging
        ? root.nearest-corner(root.mini-drag-x, root.mini-drag-y)
        : root.mini-corner;
    in property <float> video-aspect: 16 / 9;      // display aspect from mpv; 16/9 until known
    in property <float> mini-shadow: 0.0;          // 0..1, C++ sets 1 after settle, 0 at motion start
    in property <bool> mini-closing: false;        // playback went idle: fade the tile/pill out in place
    in-out property <bool> mini-fps-cap: false;    // opt-in 30 fps cap, session-only (§3.6)

    property <float> mini-aspect: clamp(root.video-aspect, 0.5, 3.0);
    // Landscape: width from the window width. Portrait: height from the window height (§3.1).
    property <bool> mini-portrait: root.mini-aspect < 1.0;
    property <length> mini-landscape-w: clamp(root.width * Theme.mini-width-ratio, Theme.mini-min-width, Theme.mini-max-width);
    property <length> mini-portrait-h: clamp(root.height * Theme.mini-portrait-height-ratio, Theme.mini-portrait-min-height, Theme.mini-portrait-max-height);
    out property <length> mini-w: root.mini-portrait ? root.mini-portrait-h * root.mini-aspect : root.mini-landscape-w;
    out property <length> mini-h: root.mini-portrait ? root.mini-portrait-h : root.mini-landscape-w / root.mini-aspect;
    out property <length> pill-w: mini-pill.ideal-width;
    property <bool> mini-at-bottom: root.mini-corner == MiniCorner.BottomRight || root.mini-corner == MiniCorner.BottomLeft;
    out property <length> picker-bottom-inset: !root.mini-at-bottom ? 0px
        : root.mini-state == MiniState.Tile ? root.mini-h + 2 * Theme.mini-margin
        : root.mini-state == MiniState.Pill ? Theme.mini-pill-height + 2 * Theme.mini-margin
        : 0px;
    // Top corners reserve a band above the whole picker instead: nothing there scrolls, so
    // the tile or pill would otherwise cover the breadcrumbs, sidebar nav and first row.
    out property <length> picker-top-clearance: root.mini-at-bottom ? 0px
        : root.mini-state == MiniState.Tile ? Theme.mini-top-margin + root.mini-h + Theme.mini-margin
        : root.mini-state == MiniState.Pill ? Theme.mini-top-margin + Theme.mini-pill-height + Theme.mini-margin
        : 0px;
    out property <length> mini-tile-x: video-view.shown-tile-x;
    out property <length> mini-tile-y: video-view.shown-tile-y;
    out property <length> mini-pill-x: mini-pill.x;
    out property <length> mini-pill-y: mini-pill.y;

    // Player <-> mini morph (§4.1, §4.2)
    out property <float> mini-t: root.mini-active ? 1.0 : 0.0;
    animate mini-t {
        duration: root.mini-active ? Theme.mini-shrink-duration : Theme.mini-expand-duration;
        easing: ease-out-expo;
    }

    // Tile <-> pill collapse (§4.4)
    out property <float> collapse-t: root.mini-state == MiniState.Pill ? 1.0 : 0.0;
    animate collapse-t {
        duration: Theme.mini-collapse-duration;
        easing: cubic-bezier(0.65, 0, 0.35, 1); // ease-in-out-cubic
    }

    // A morph is running or the mini player is up: the picker stays fully opaque beneath
    // the moving video (no opacity layer on the picker, §4.5 rule 2).
    property <bool> morphing: root.mini-active || root.mini-t > 0.001;

    // Idle/error dismissal fade (§8); animated only on the way out.
    property <float> close-fade: root.mini-closing ? 0.0 : 1.0;
    animate close-fade { duration: root.mini-closing ? Theme.mini-close-fade-duration : 0ms; }

    // Settled shadow fade-in (§4.5 rule 3): fades in over 160ms, drops instantly.
    property <float> shadow-k: root.mini-shadow;
    animate shadow-k { duration: root.mini-shadow > 0.5 ? 160ms : 0ms; }

    changed mini-w => { root.mini-geometry-changed(); }
    changed mini-h => { root.mini-geometry-changed(); }

    // --- Window & HUD State ---
    in-out property <bool> is-fullscreen: false;
    in-out property <bool> is-maximized: false;
    in-out property <ActivePopover> active-popover: ActivePopover.None;
    in-out property <bool> hud-visible: true;
    in-out property <int> pointer-idle-ms: 0;

    property <bool> hud-locked: !root.is-playing
                             || !root.has-video
                             || root.is-buffering
                             || top-bar.has-hover
                             || controls-bar.has-hover
                             || controls-bar.is-scrubbing
                             || root.active-popover != ActivePopover.None;

    // --- Callbacks to C++ Backend ---
    callback play-pause-clicked();
    callback prev-clicked();
    callback next-clicked();
    callback stop-clicked();
    callback seek-requested(float);              // Normalized 0.0 .. 1.0
    callback relative-seek-requested(float);     // Relative seconds (e.g. -5.0, +5.0)
    callback volume-changed(float);
    callback mute-toggled();
    callback ab-loop-cycled();
    callback ab-loop-cleared();
    callback loop-mode-cycled();
    callback subtitle-track-selected(int);       // -1 for "Off" (sid=no)
    callback load-external-subtitle-clicked();
    callback audio-track-selected(int);
    callback chapter-selected(int);
    callback speed-changed(float);
    callback hwdec-changed(string);
    callback aspect-changed(string);
    callback open-file-clicked();
    callback open-url-submitted(string);
    callback minimize-clicked();
    callback maximize-toggled();
    callback fullscreen-toggled();
    callback close-clicked();
    callback window-drag-requested(float, float); // delta-x, delta-y in logical px
    callback viewport-resized(int, int);

    // --- Video Picker Callbacks ---
    callback picker-nav-selected(PickerNavKind, string /* path */);
    callback picker-folder-toggled(string /* path */);
    callback picker-breadcrumb-clicked(int /* index */);
    callback picker-navigate-up();
    callback picker-video-clicked(string /* path */, bool /* resume */);
    callback picker-mark-watched(string /* path */, bool /* watched */);
    callback picker-reveal-in-file-manager(string /* path */);
    callback picker-request-thumbnail(string /* cache_key_hex */, string /* path */);
    callback picker-grid-columns-changed(int /* columns */);
    callback picker-search-changed(string);
    callback picker-sort-changed(PickerSortMode);
    callback picker-open-external-folder();
    callback return-to-picker-clicked();
    callback return-to-player-clicked();

    // --- Mini Player Callbacks ---
    callback mini-expand-clicked();
    callback mini-minimize-clicked();                   // ✕ / Ctrl+W: pause + collapse to pill
    callback mini-restore-clicked(bool /* resume */);   // pill body (false) or ▶ / Space (true)
    callback mini-geometry-changed();                   // tile size changed; C++ reads mini-w/h
    callback mini-fps-cap-changed(bool);

    function corner-x(c: MiniCorner, w: length) -> length {
        return (c == MiniCorner.BottomRight || c == MiniCorner.TopRight)
            ? window-shell.width - w - Theme.mini-margin
            : Theme.mini-margin;
    }

    function corner-y(c: MiniCorner, h: length) -> length {
        return (c == MiniCorner.BottomRight || c == MiniCorner.BottomLeft)
            ? window-shell.height - h - Theme.mini-margin
            : Theme.mini-top-margin;
    }

    function nearest-corner(x: length, y: length) -> MiniCorner {
        if (x + root.mini-w / 2 >= window-shell.width / 2) {
            return (y + root.mini-h / 2 >= (Theme.mini-top-margin + window-shell.height - Theme.mini-margin) / 2)
                ? MiniCorner.BottomRight
                : MiniCorner.TopRight;
        } else {
            return (y + root.mini-h / 2 >= (Theme.mini-top-margin + window-shell.height - Theme.mini-margin) / 2)
                ? MiniCorner.BottomLeft
                : MiniCorner.TopLeft;
        }
    }

    // Spring the tile from where it is to the corner in mini-corner (§12.4B).
    function start-snap() {
        root.mini-snapping = true;
        root.mini-dragging = false;
        root.mini-held = false;
        snap-settle-timer.running = false;
        snap-settle-timer.running = true;
    }

    // Pin the tile at its current drawn position and stop any snap in flight.
    function hold-tile() {
        root.mini-drag-x = video-view.shown-tile-x;
        root.mini-drag-y = video-view.shown-tile-y;
        snap-settle-timer.running = false;
        root.mini-snapping = false;
        root.mini-dragging = false;
        root.mini-held = true;
    }

    function reset-hud-timer() {
        root.pointer-idle-ms = 0;
        root.hud-visible = true;
    }

    public function cycle-subtitles() {
        if (root.subtitle-tracks.length <= 0) {
            return;
        }
        if (!root.has-subtitles-enabled || root.active-subtitle-index < 0) {
            root.active-subtitle-index = 0;
            root.has-subtitles-enabled = true;
            root.subtitle-track-selected(root.subtitle-tracks[0].id);
        } else if (root.active-subtitle-index + 1 < root.subtitle-tracks.length) {
            root.active-subtitle-index += 1;
            root.has-subtitles-enabled = true;
            root.subtitle-track-selected(root.subtitle-tracks[root.active-subtitle-index].id);
        } else {
            root.active-subtitle-index = -1;
            root.has-subtitles-enabled = false;
            root.subtitle-track-selected(-1);
        }
    }

    changed active-popover => {
        if (root.active-popover != ActivePopover.OpenUrlModal) {
            key-scope.focus();
        }
    }

    // Expand click guard (§3.3): after leaving mini mode for the player, swallow clicks on the
    // video for one double-click interval. Otherwise the second click of a double-click on
    // the tile lands on the full player (mini-mode drops within ~30ms of the expand) and
    // toggles pause and fullscreen.
    expand-click-guard := Timer {
        interval: Theme.mini-expand-click-guard;
        running: false;
        triggered => { self.running = false; }
    }
    snap-settle-timer := Timer {
        interval: Theme.mini-snap-duration + 20ms;
        running: false;
        triggered => {
            self.running = false;
            root.mini-snapping = false;
        }
    }
    changed mini-active => {
        if (!root.mini-active && root.view-mode == AppViewMode.Player) {
            expand-click-guard.running = true;
        }
    }
    changed mini-state => {
        if (root.mini-state == MiniState.Tile) {
            root.mini-dragging = false;
            root.mini-held = false;
            root.mini-snapping = false;
            snap-settle-timer.running = false;
        } else if (root.mini-state == MiniState.Hidden) {
            // Expand mid-drag / mid-snap (§12.4C): no corner is committed; the morph to full
            // screen starts from wherever the tile is.
            if (root.mini-dragging || root.mini-snapping) {
                root.hold-tile();
            }
        } else {
            // Minimize mid-drag / mid-snap: commit the hovered corner and collapse into it.
            if (root.mini-dragging) {
                root.mini-corner = root.nearest-corner(root.mini-drag-x, root.mini-drag-y);
            }
            if (root.mini-dragging || root.mini-held) {
                root.start-snap();
            }
        }
    }
    changed mini-closing => {
        if (root.mini-closing && root.mini-dragging) {
            root.mini-corner = root.nearest-corner(root.mini-drag-x, root.mini-drag-y);
            root.start-snap();
        }
    }

    // HUD Auto-Hide Timer (250ms tick -> hide at 2500ms)
    hud-timer := Timer {
        interval: 250ms;
        running: true;
        triggered => {
            if (root.hud-locked) {
                root.pointer-idle-ms = 0;
                root.hud-visible = true;
            } else {
                root.pointer-idle-ms += 250;
                if (root.pointer-idle-ms >= 2500) {
                    root.hud-visible = false;
                }
            }
        }
    }

    // Rounded Frameless Window Shell (12px radius when windowed, 0px when maximized/fullscreen)
    window-shell := Rectangle {
        x: 0px;
        y: 0px;
        width: 100%;
        height: 100%;
        background: Theme.canvas-bg;
        border-radius: (root.is-fullscreen || root.is-maximized) ? 0px : Theme.window-radius;
        clip: true;

        changed width => {
            root.viewport-resized(Math.round(self.width / 1px), Math.round(self.height / 1px));
        }
        changed height => {
            root.viewport-resized(Math.round(self.width / 1px), Math.round(self.height / 1px));
        }

        // 1. Video Picker Library Layer (beneath the video so the shrinking rect reveals it)
        VideoPicker {
            visible: root.view-mode == AppViewMode.Picker || root.morphing || root.picker-opacity > 0.01;
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            opacity: root.morphing ? 1.0 : root.picker-opacity;
            bottom-inset: root.picker-bottom-inset;
            top-clearance: root.picker-top-clearance;
            sidebar-open: root.sidebar-open;
            active-nav-kind: root.active-nav-kind;
            folders: root.picker-folders;
            breadcrumbs: root.picker-breadcrumbs;
            continue-watching: root.picker-continue-watching;
            direct-video-rows: root.picker-direct-video-rows;
            grid-columns: root.picker-grid-columns;
            shelves: root.picker-shelves;
            scanning: root.picker-scanning;
            search-query: root.picker-search-query;

            nav-selected(kind, path) => { root.picker-nav-selected(kind, path); }
            folder-toggled(path) => { root.picker-folder-toggled(path); }
            breadcrumb-clicked(idx) => { root.picker-breadcrumb-clicked(idx); }
            video-clicked(path, resume) => { root.picker-video-clicked(path, resume); }
            mark-watched(path, watched) => { root.picker-mark-watched(path, watched); }
            reveal-in-file-manager(path) => { root.picker-reveal-in-file-manager(path); }
            request-thumbnail(id, path) => { root.picker-request-thumbnail(id, path); }
            grid-columns-changed(cols) => { root.picker-grid-columns-changed(cols); }
            open-file-clicked => { root.open-file-clicked(); }
            open-folder-clicked => { root.picker-open-external-folder(); }
        }

        // 1b. Corner Drop-Zone Targets (shown beneath the dragged mini tile, v2 §12.2)
        MiniCornerGuides {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            active: root.mini-dragging && root.mini-state == MiniState.Tile && !root.mini-closing;
            target-corner: root.mini-snap-preview;
            tile-width: root.mini-w;
            tile-height: root.mini-h;
        }

        // 2. Video Canvas: full-bleed in the player, morphs into the mini tile/pill (§6.3, §12).
        // The single persistent moving element: never recreated, never reparented (§4.5 rule 1).
        video-view := VideoView {
            // Corner-anchored tile & pill rects (v2 supports all 4 corners)
            property <length> target-tile-x: root.corner-x(root.mini-corner, root.mini-w);
            property <length> target-tile-y: root.corner-y(root.mini-corner, root.mini-h);
            property <length> tile-x: (root.mini-dragging || root.mini-held) ? root.mini-drag-x : self.target-tile-x;
            property <length> tile-y: (root.mini-dragging || root.mini-held) ? root.mini-drag-y : self.target-tile-y;
            animate tile-x {
                duration: root.mini-snapping ? Theme.mini-snap-duration : 0ms;
                easing: cubic-bezier(0.22, 1.25, 0.36, 1);
            }
            animate tile-y {
                duration: root.mini-snapping ? Theme.mini-snap-duration : 0ms;
                easing: cubic-bezier(0.22, 1.25, 0.36, 1);
            }
            // The spring overshoots by ~2% of its travel, which on a long throw in a large window
            // passes the 16px margin. Keep it inside the drag pads (8px sides, 64px under TopBar).
            property <length> shown-tile-x: !root.mini-snapping ? self.tile-x : clamp(
                self.tile-x,
                Theme.mini-drag-edge-pad,
                max(Theme.mini-drag-edge-pad, window-shell.width - root.mini-w - Theme.mini-drag-edge-pad));
            property <length> shown-tile-y: !root.mini-snapping ? self.tile-y : clamp(
                self.tile-y,
                Theme.mini-top-drag-edge-pad,
                max(Theme.mini-top-drag-edge-pad, window-shell.height - root.mini-h - Theme.mini-drag-edge-pad));

            property <length> pill-x: root.corner-x(root.mini-corner, root.pill-w);
            property <length> pill-y: root.corner-y(root.mini-corner, Theme.mini-pill-height);
            // Mini rect = tile rect interpolated toward the pill rect by collapse-t
            property <length> m-x: self.shown-tile-x + (self.pill-x - self.shown-tile-x) * root.collapse-t;
            property <length> m-y: self.shown-tile-y + (self.pill-y - self.shown-tile-y) * root.collapse-t;
            property <length> m-w: root.mini-w + (root.pill-w - root.mini-w) * root.collapse-t;
            property <length> m-h: root.mini-h + (Theme.mini-pill-height - root.mini-h) * root.collapse-t;

            // Full window rect interpolated toward the mini rect by mini-t
            x: self.m-x * root.mini-t;
            y: self.m-y * root.mini-t;
            width: window-shell.width + (self.m-w - window-shell.width) * root.mini-t;
            height: window-shell.height + (self.m-h - window-shell.height) * root.mini-t;
            border-radius: (Theme.card-radius + (Theme.mini-pill-radius - Theme.card-radius) * root.collapse-t) * root.mini-t;

            property <bool> drag-lifted: root.mini-dragging && root.mini-state == MiniState.Tile;
            // During drag and snap the tile only translates, so the fixed 24px shadow is never
            // re-blurred (§4.5 rule 3, §12.2). Keeping it through the snap lets the lift ease
            // out even when the drag began before the settled shadow (shadow-k == 0).
            property <bool> drag-shadow: (root.mini-dragging || root.mini-snapping)
                && root.mini-state == MiniState.Tile && !root.mini-closing;
            drop-shadow-blur: (root.shadow-k > 0.0 || self.drag-shadow) ? 24px : 0px;
            drop-shadow-offset-y: self.drag-lifted ? 14px : 8px;
            drop-shadow-color: self.drag-lifted ? #000000cc : #00000099.transparentize(1.0 - root.shadow-k);
            animate drop-shadow-offset-y { duration: 140ms; easing: ease-out; }
            animate drop-shadow-color { duration: 140ms; easing: ease-out; }

            // Outside a morph, VideoView fades in over the picker (plain crossfade when no
            // mini player is involved, e.g. opening a file from an empty picker).
            visible: (root.view-mode == AppViewMode.Player || root.mini-active || root.picker-opacity < 0.99)
                  && root.collapse-t < 0.999;
            opacity: root.close-fade * (root.morphing ? 1.0 : 1.0 - root.picker-opacity);

            video-frame: root.video-frame;
            has-video: root.has-video;
            is-playing: root.is-playing;
            is-buffering: root.is-buffering || (root.has-video && controls-bar.is-scrubbing);
            hud-visible: root.hud-visible || root.hud-locked;
            mini-mode: root.mini-t > 0.5;
            suppress-clicks: expand-click-guard.running;
            mini-chrome-visible: root.mini-state == MiniState.Tile && root.mini-t >= 0.95 && root.collapse-t == 0.0 && !root.mini-closing;
            mini-dragging: root.mini-dragging;
            mini-snapping: root.mini-snapping;
            // Drag only once the shrink has finished: mid-morph the drawn rect is m-x * mini-t
            // and still resizing, so a drag seeded from the resting position would jump.
            mini-drag-enabled: root.mini-t >= 1.0;
            progress: root.progress;
            media-title: root.media-title;

            pointer-activity => { root.reset-hud-timer(); }
            single-clicked => {
                if (root.active-popover != ActivePopover.None) {
                    root.active-popover = ActivePopover.None;
                } else if (root.has-video) {
                    root.play-pause-clicked();
                }
            }
            double-clicked => { root.fullscreen-toggled(); }
            open-clicked => { root.open-file-clicked(); }
            expand-clicked => { root.mini-expand-clicked(); }
            mini-play-pause-clicked => { root.play-pause-clicked(); }
            mini-minimize-clicked => { root.mini-minimize-clicked(); }
            // A press during a snap freezes the spring where it is, so the tile does not move
            // under the pointer and the spring's motion never counts toward the drag
            // threshold (§12.3.5). Releasing without dragging lets the snap finish.
            mini-press-started => {
                if (root.mini-snapping) {
                    root.hold-tile();
                }
            }
            mini-press-released => {
                if (root.mini-held && root.mini-state == MiniState.Tile && !root.mini-closing) {
                    root.start-snap();
                }
            }
            mini-drag-started => {
                if (!root.mini-held) {
                    root.mini-drag-x = self.shown-tile-x;
                    root.mini-drag-y = self.shown-tile-y;
                }
                snap-settle-timer.running = false;
                root.mini-snapping = false;
                root.mini-held = false;
                root.mini-dragging = true;
            }
            mini-drag-moved(dx, dy) => {
                if (!root.mini-dragging) {
                    return;
                }
                root.mini-drag-x = clamp(
                    root.mini-drag-x + dx,
                    Theme.mini-drag-edge-pad,
                    max(Theme.mini-drag-edge-pad, window-shell.width - root.mini-w - Theme.mini-drag-edge-pad)
                );
                root.mini-drag-y = clamp(
                    root.mini-drag-y + dy,
                    Theme.mini-top-drag-edge-pad,
                    max(Theme.mini-top-drag-edge-pad, window-shell.height - root.mini-h - Theme.mini-drag-edge-pad)
                );
            }
            mini-drag-ended => {
                if (!root.mini-dragging) {
                    return;
                }
                root.mini-corner = root.nearest-corner(root.mini-drag-x, root.mini-drag-y);
                root.start-snap();
            }
        }

        // 3. Minimized mini player, drawn above the video so it covers the collapsing tile (§4.4)
        mini-pill := MiniPill {
            x: video-view.pill-x;
            y: video-view.pill-y;
            width: root.pill-w;
            // Expanding from the pill (view-mode becomes Player) keeps it drawn while it fades
            // out over the combined morph (§6.3). After an idle close (still Picker, no longer
            // mini) collapse-t also runs back to 0, but the pill must not reappear then.
            visible: root.collapse-t > 0.001 && (root.mini-active || root.view-mode == AppViewMode.Player);
            opacity: root.close-fade * clamp((root.collapse-t - 0.4) / 0.6, 0.0, 1.0);
            title: root.media-title;
            restore-clicked => { root.mini-restore-clicked(false); }
            play-clicked => { root.mini-restore-clicked(true); }
            expand-clicked => { root.mini-expand-clicked(); }
        }

        // 4. Backdrop Dismissal Layer for Active Popovers
        if root.active-popover != ActivePopover.None : TouchArea {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            clicked => {
                root.reset-hud-timer();
                root.active-popover = ActivePopover.None;
            }
        }

        // 5. Top Gradient Overlay Bar (64px)
        top-bar := TopBar {
            x: 0px;
            y: 0px;
            width: 100%;
            media-title: root.media-title;
            is-maximized: root.is-maximized;
            is-fullscreen: root.is-fullscreen;
            view-mode: root.view-mode;
            sidebar-open: root.sidebar-open;
            has-video: root.has-video;
            picker-search-query <=> root.picker-search-query;
            picker-sort-mode <=> root.picker-sort-mode;
            active-popover <=> root.active-popover;
            opacity: (root.view-mode == AppViewMode.Picker || root.hud-visible || root.hud-locked) ? 1.0 : 0.0;
            animate opacity { duration: 220ms; easing: ease-out; }

            pointer-activity => { root.reset-hud-timer(); }
            minimize-clicked => { root.minimize-clicked(); }
            maximize-toggled => { root.maximize-toggled(); }
            close-clicked => { root.close-clicked(); }
            window-drag-requested(dx, dy) => { root.window-drag-requested(dx, dy); }
            toggle-sidebar-clicked => { root.sidebar-open = !root.sidebar-open; }
            return-to-picker-clicked => { root.return-to-picker-clicked(); }
            return-to-player-clicked => { root.return-to-player-clicked(); }
            picker-search-changed(q) => { root.picker-search-changed(q); }
            picker-sort-changed(m) => { root.picker-sort-changed(m); }
        }

        // 6. Bottom Gradient Overlay Bar (104px)
        controls-bar := ControlsBar {
            x: 0px;
            y: parent.height - self.height;
            width: 100%;
            visible: root.view-mode == AppViewMode.Player;
            is-playing: root.is-playing;
            progress: root.progress;
            time-text: root.time-text;
            volume: root.volume;
            is-muted: root.is-muted;
            has-subtitles-enabled: root.has-subtitles-enabled;
            loop-mode: root.loop-mode;
            ab-loop-state: root.ab-loop-state;
            ab-loop-a-norm: root.ab-loop-a-norm;
            ab-loop-b-norm: root.ab-loop-b-norm;
            chapters: root.chapters;
            is-fullscreen: root.is-fullscreen;
            active-popover <=> root.active-popover;
            opacity: (root.view-mode == AppViewMode.Player && (root.hud-visible || root.hud-locked)) ? 1.0 : 0.0;
            animate opacity { duration: 220ms; easing: ease-out; }

            pointer-activity => { root.reset-hud-timer(); }
            prev-clicked => { root.prev-clicked(); }
            play-pause-clicked => { root.play-pause-clicked(); }
            next-clicked => { root.next-clicked(); }
            mute-toggled => { root.mute-toggled(); }
            volume-changed(v) => { root.volume-changed(v); }
            ab-loop-cycled => { root.ab-loop-cycled(); }
            ab-loop-cleared => { root.ab-loop-cleared(); }
            loop-mode-cycled => { root.loop-mode-cycled(); }
            fullscreen-toggled => { root.fullscreen-toggled(); }
            seek-requested(pos) => { root.seek-requested(pos); }
        }

        // 7. Floating Glassmorphic Popovers
        PopoverLayer {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            active-popover <=> root.active-popover;
            subtitle-tracks: root.subtitle-tracks;
            audio-tracks: root.audio-tracks;
            chapters: root.chapters;
            has-subtitles-enabled: root.has-subtitles-enabled;
            playback-speed <=> root.playback-speed;
            hwdec-mode <=> root.hwdec-mode;
            aspect-ratio <=> root.aspect-ratio;
            mini-fps-cap <=> root.mini-fps-cap;
            media-title: root.media-title;

            open-file-clicked => { root.open-file-clicked(); }
            open-url-submitted(url) => { root.open-url-submitted(url); }
            subtitle-track-selected(id) => { root.subtitle-track-selected(id); }
            load-external-subtitle-clicked => { root.load-external-subtitle-clicked(); }
            audio-track-selected(id) => { root.audio-track-selected(id); }
            chapter-selected(idx) => { root.chapter-selected(idx); }
            speed-changed(s) => { root.speed-changed(s); }
            hwdec-changed(m) => { root.hwdec-changed(m); }
            aspect-changed(a) => { root.aspect-changed(a); }
            mini-fps-cap-changed(enabled) => { root.mini-fps-cap-changed(enabled); }
        }

        // Subtle 1px outer border ring in windowed mode
        Rectangle {
            x: 0px;
            y: 0px;
            width: 100%;
            height: 100%;
            background: transparent;
            border-radius: parent.border-radius;
            border-width: (root.is-fullscreen || root.is-maximized) ? 0px : 1px;
            border-color: Theme.window-border;
        }
    }

    // Keyboard Shortcuts Handler (when URL modal text input is not active)
    key-scope := FocusScope {
        width: 0px;
        height: 0px;
        enabled: root.active-popover != ActivePopover.OpenUrlModal;

        key-pressed(event) => {
            root.reset-hud-timer();

            if (root.view-mode == AppViewMode.Picker) {
                if (event.modifiers.control && (event.text == "b" || event.text == "B")) {
                    root.sidebar-open = !root.sidebar-open;
                    return accept;
                }
                if (event.text == "/" || (event.modifiers.control && (event.text == "f" || event.text == "F"))) {
                    top-bar.focus-search();
                    return accept;
                }
                if (event.text == " " && !top-bar.search-focused) {
                    if (root.mini-state == MiniState.Tile) {
                        root.play-pause-clicked();
                        return accept;
                    } else if (root.mini-state == MiniState.Pill) {
                        root.mini-restore-clicked(true);
                        return accept;
                    }
                }
                if (event.modifiers.control && (event.text == "w" || event.text == "W")
                        && root.mini-state == MiniState.Tile) {
                    root.mini-minimize-clicked();
                    return accept;
                }
                if (event.text == Key.Backspace && !top-bar.search-focused) {
                    root.picker-navigate-up();
                    return accept;
                }
                if (event.text == Key.Escape) {
                    if (root.picker-search-query != "") {
                        root.picker-search-query = "";
                        root.picker-search-changed("");
                        key-scope.focus();
                        return accept;
                    } else if (root.has-video) {
                        root.return-to-player-clicked();
                        return accept;
                    }
                }
                return reject;
            }

            if (event.text == " " || event.text == "k" || event.text == "K") {
                root.play-pause-clicked();
                return accept;
            }
            if (event.text == Key.LeftArrow) {
                root.relative-seek-requested(-5.0);
                return accept;
            }
            if (event.text == Key.RightArrow) {
                root.relative-seek-requested(5.0);
                return accept;
            }
            if (event.text == Key.UpArrow) {
                root.volume-changed(min(100.0, root.volume + 5.0));
                return accept;
            }
            if (event.text == Key.DownArrow) {
                root.volume-changed(max(0.0, root.volume - 5.0));
                return accept;
            }
            if (event.text == "m" || event.text == "M") {
                root.mute-toggled();
                return accept;
            }
            if (event.text == "f" || event.text == "F" || event.text == Key.F11) {
                root.fullscreen-toggled();
                return accept;
            }
            if (event.text == "l" || event.text == "L") {
                root.ab-loop-cycled();
                return accept;
            }
            if (event.text == "c" || event.text == "C") {
                root.cycle-subtitles();
                return accept;
            }
            if (event.text == Key.Escape) {
                if (root.active-popover != ActivePopover.None) {
                    root.active-popover = ActivePopover.None;
                    return accept;
                } else if (root.is-fullscreen) {
                    root.fullscreen-toggled();
                    return accept;
                } else {
                    root.return-to-picker-clicked();
                    return accept;
                }
            }
            return reject;
        }
    }
}
