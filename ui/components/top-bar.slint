import { Theme, ActivePopover, AppViewMode, PickerSortMode } from "../theme.slint";
import { IconButton } from "icon-button.slint";

export component TopBar inherits Rectangle {
    in property <string> media-title: "";
    in property <bool> is-maximized: false;
    in property <bool> is-fullscreen: false;
    in property <AppViewMode> view-mode: AppViewMode.Player;
    in property <bool> sidebar-open: true;
    in property <bool> has-video: false;
    in-out property <string> picker-search-query: "";
    in-out property <PickerSortMode> picker-sort-mode: PickerSortMode.Name;
    in-out property <ActivePopover> active-popover: ActivePopover.None;

    out property <bool> search-focused: search-input.has-focus;
    out property <bool> has-hover: bar-touch.has-hover
                                || open-touch.has-hover
                                || drag-touch.has-hover
                                || menu-btn.has-hover
                                || min-btn.has-hover
                                || max-btn.has-hover
                                || close-btn.has-hover;

    callback minimize-clicked();
    callback maximize-toggled();
    callback close-clicked();
    callback window-drag-requested(float, float);
    callback pointer-activity();
    callback toggle-sidebar-clicked();
    callback return-to-picker-clicked();
    callback return-to-player-clicked();
    callback picker-search-changed(string);
    callback picker-sort-changed(PickerSortMode);

    public function focus-search() {
        search-input.focus();
    }

    height: Theme.top-gradient-height;
    background: Theme.hud-gradient-top;

    bar-touch := TouchArea {
        width: 100%;
        height: 100%;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.move || event.kind == PointerEventKind.down) {
                root.pointer-activity();
            }
        }
    }

    HorizontalLayout {
        x: 0px;
        y: 0px;
        width: 100%;
        height: Theme.top-bar-content-height;
        padding-left: 16px;
        padding-right: 16px;
        spacing: 12px;

        // Left: Picker Sidebar Toggle / Player Library + Open Menu
        if root.view-mode == AppViewMode.Picker : HorizontalLayout {
            spacing: 8px;
            alignment: start;

            IconButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("../assets/icons/panel-left.svg");
                tooltip: "Toggle Sidebar (Ctrl+B)";
                active: root.sidebar-open;
                clicked => {
                    root.pointer-activity();
                    root.toggle-sidebar-clicked();
                }
            }

            if root.has-video : Rectangle {
                width: resume-pill-txt.preferred-width + 20px;
                height: 30px;
                y: (parent.height - self.height) / 2;
                border-radius: 15px;
                background: resume-pill-touch.has-hover ? Theme.btn-circle-hover : Theme.popover-item-active;
                border-width: 1px;
                border-color: Theme.sidebar-border;
                animate background { duration: 150ms; easing: ease-out; }

                resume-pill-txt := Text {
                    text: "Now Playing ›";
                    font-size: 12px;
                    font-weight: 500;
                    color: Theme.text-primary;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                resume-pill-touch := TouchArea {
                    mouse-cursor: MouseCursor.pointer;
                    clicked => { root.return-to-player-clicked(); }
                }
            }
        }

        if root.view-mode == AppViewMode.Player : IconButton {
            y: (parent.height - self.height) / 2;
            icon: @image-url("../assets/icons/layout-grid.svg");
            tooltip: "Return to Library (Esc)";
            clicked => {
                root.pointer-activity();
                root.return-to-picker-clicked();
            }
        }

        Rectangle {
            visible: root.view-mode == AppViewMode.Player;
            width: root.view-mode == AppViewMode.Player ? 62px : 0px;
            height: 34px;
            y: (parent.height - self.height) / 2;
            border-radius: 17px;
            clip: true;
            background: open-touch.pressed ? Theme.btn-circle-pressed
                      : open-touch.has-hover ? Theme.btn-circle-hover
                      : (root.active-popover == ActivePopover.OpenMenu || root.active-popover == ActivePopover.OpenUrlModal) ? Theme.btn-circle-active
                      : Theme.btn-circle-idle;
            animate background { duration: 150ms; easing: ease-in-out; }

            accessible-role: button;
            accessible-label: "Open Media Menu";

            HorizontalLayout {
                alignment: center;
                spacing: 4px;
                padding-left: 10px;
                padding-right: 8px;

                Image {
                    source: @image-url("../assets/icons/folder-open.svg");
                    width: 18px;
                    height: 18px;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.icon-primary;
                }

                Image {
                    source: @image-url("../assets/icons/chevron-down.svg");
                    width: 14px;
                    height: 14px;
                    y: (parent.height - self.height) / 2;
                    colorize: Theme.icon-muted;
                }
            }

            open-touch := TouchArea {
                enabled: root.view-mode == AppViewMode.Player;
                mouse-cursor: MouseCursor.pointer;
                clicked => {
                    root.pointer-activity();
                    if (root.active-popover == ActivePopover.OpenMenu) {
                        root.active-popover = ActivePopover.None;
                    } else {
                        root.active-popover = ActivePopover.OpenMenu;
                    }
                }
            }
        }

        // Center: Media Title & Window Drag Area (+ Picker Search / Sort)
        Rectangle {
            horizontal-stretch: 1;
            height: 100%;

            if root.view-mode == AppViewMode.Player : Text {
                width: 100%;
                height: 100%;
                text: root.media-title != "" ? root.media-title : "mpvx";
                font-size: 13px;
                font-weight: 500;
                color: root.media-title != "" ? Theme.text-primary : Theme.text-muted;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
            }

            if root.view-mode == AppViewMode.Picker : Text {
                x: 8px;
                height: 100%;
                text: "mpvx";
                font-size: 14px;
                font-weight: 600;
                color: Theme.text-primary;
                vertical-alignment: center;
            }

            drag-touch := TouchArea {
                width: 100%;
                height: 100%;
                double-clicked => {
                    root.pointer-activity();
                    root.maximize-toggled();
                }
                pointer-event(event) => {
                    if (event.kind == PointerEventKind.down) {
                        root.pointer-activity();
                    } else if (event.kind == PointerEventKind.move) {
                        root.pointer-activity();
                        if (self.pressed && !root.is-maximized && !root.is-fullscreen) {
                            root.window-drag-requested(
                                (self.mouse-x - self.pressed-x) / 1px,
                                (self.mouse-y - self.pressed-y) / 1px
                            );
                        }
                    }
                }
            }

            HorizontalLayout {
                visible: root.view-mode == AppViewMode.Picker;
                alignment: end;
                spacing: 8px;
                padding-right: 4px;

                // Search Filter Box
                Rectangle {
                    width: 220px;
                    height: 32px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: #ffffff10;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.icon-accent : Theme.sidebar-border;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;

                        Image {
                            source: @image-url("../assets/icons/search.svg");
                            width: 14px;
                            height: 14px;
                            y: (parent.height - self.height) / 2;
                            colorize: Theme.icon-muted;
                        }

                        search-input := TextInput {
                            horizontal-stretch: 1;
                            height: 100%;
                            text <=> root.picker-search-query;
                            font-size: 12px;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                            edited => {
                                root.picker-search-changed(self.text);
                            }
                        }
                    }

                    if root.picker-search-query == "" : Text {
                        x: 30px;
                        height: 100%;
                        text: "Search videos… (/)";
                        font-size: 12px;
                        color: Theme.text-muted;
                        vertical-alignment: center;
                    }
                }

                // Sort Mode Cycle Pill
                Rectangle {
                    width: sort-label.preferred-width + 20px;
                    height: 32px;
                    y: (parent.height - self.height) / 2;
                    border-radius: 8px;
                    background: sort-touch.has-hover ? Theme.btn-circle-hover : #ffffff10;
                    border-width: 1px;
                    border-color: Theme.sidebar-border;
                    animate background { duration: 120ms; easing: ease-out; }

                    sort-label := Text {
                        text: root.picker-sort-mode == PickerSortMode.Name ? "Sort: Name"
                            : root.picker-sort-mode == PickerSortMode.Recent ? "Sort: Recent"
                            : "Sort: Progress";
                        font-size: 12px;
                        font-weight: 500;
                        color: Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    sort-touch := TouchArea {
                        mouse-cursor: MouseCursor.pointer;
                        clicked => {
                            if (root.picker-sort-mode == PickerSortMode.Name) {
                                root.picker-sort-mode = PickerSortMode.Recent;
                            } else if (root.picker-sort-mode == PickerSortMode.Recent) {
                                root.picker-sort-mode = PickerSortMode.Progress;
                            } else {
                                root.picker-sort-mode = PickerSortMode.Name;
                            }
                            root.picker-sort-changed(root.picker-sort-mode);
                        }
                    }
                }
            }
        }

        // Right: App Menu & Frameless Window Controls
        HorizontalLayout {
            spacing: 6px;
            alignment: end;

            menu-btn := IconButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("../assets/icons/menu.svg");
                tooltip: "Application Menu";
                active: root.active-popover == ActivePopover.AppMenu;
                clicked => {
                    root.pointer-activity();
                    if (root.active-popover == ActivePopover.AppMenu) {
                        root.active-popover = ActivePopover.None;
                    } else {
                        root.active-popover = ActivePopover.AppMenu;
                    }
                }
            }

            min-btn := IconButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("../assets/icons/minus.svg");
                tooltip: "Minimize";
                clicked => {
                    root.pointer-activity();
                    root.minimize-clicked();
                }
            }

            max-btn := IconButton {
                y: (parent.height - self.height) / 2;
                icon: root.is-maximized
                    ? @image-url("../assets/icons/copy.svg")
                    : @image-url("../assets/icons/square.svg");
                tooltip: root.is-maximized ? "Restore" : "Maximize";
                clicked => {
                    root.pointer-activity();
                    root.maximize-toggled();
                }
            }

            close-btn := IconButton {
                y: (parent.height - self.height) / 2;
                icon: @image-url("../assets/icons/x.svg");
                tooltip: "Close";
                clicked => {
                    root.pointer-activity();
                    root.close-clicked();
                }
            }
        }
    }
}
